{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://get-empath.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/",
      "destination": "/login.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/enterprise",
      "destination": "/signup.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/gofundme",
      "destination": "/org.html"
    },
    {
      "source": "/tennischannel",
      "destination": "/org.html"
    },
    {
      "source": "/merino",
      "destination": "/org.html"
    },
    {
      "source": "/ymail",
      "destination": "/org.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
